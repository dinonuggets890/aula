---
/**
 * Startseite. Reihenfolge nach Vorgabe:
 * 1. Stück und Ticket-Button (ohne Scrollen sichtbar)  2. Eckdaten
 * 3. Terminliste mit Kauf-Button je Vorstellung          4. Ensemble, Junges Theater, Archiv
 * 5. Hinter den Kulissen und Fotos                       6. Mitmachen und Mitglied werden
 * 7. Fußzeile
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Bild from '../components/Bild.astro';
import Video from '../components/Video.astro';
import Luecke from '../components/Luecke.astro';
import StueckBuehne from '../components/StueckBuehne.astro';
import Termine from '../components/Termine.astro';
import Akt from '../components/Akt.astro';
import Mitmachen from '../components/Mitmachen.astro';
import { site, fotos, fmt, isoMitZone, getChronik, getStueckInfo, jt, pfad, platzhalter } from '../lib/data';

const info = await getStueckInfo();
const { d, kommend, naechste, btsDa } = info;

const chronik = (await getChronik()).filter((e) => e.art !== 'hinweis');
const archiv = chronik.filter((e) => !d || e.titel !== d.titel).slice(0, 3);
const jtStuecke = chronik.filter((e) => e.art === 'klein').slice(0, 3);
const ensemble = d?.besetzung.filter((p) => p.name).slice(0, 4) ?? [];
const probenfotos = d?.probenfotos.slice(0, 4) ?? [];
const albumfotos = fotos.slice(0, probenfotos.length ? 4 : 6);
const fotografen = [...new Set([d?.probenfotos_fotograf, ...albumfotos.map((f) => f.fotograf)].filter(Boolean))];
const archivBild = chronik.find((e) => e.bild)?.bild ?? '';
// „Proben, Proben, Proben … und manchmal auch mit Krach-Bumm-Bäng“ -> Überschrift + Nachsatz
const [kulissenKopf, ...kulissenRest] = (d?.behind_the_scenes_text || 'Wie ein Stück entsteht').split('…');
const kulissenNachsatz = kulissenRest.join('…').trim();

const laufband = [
  d?.titel,
  d?.autor && `von ${d.autor}`,
  naechste && (naechste.premiere ? `Premiere ${fmt.tagMonat(naechste.datum)}` : `Nächste Vorstellung ${fmt.tagMonat(naechste.datum)}`),
  site.spielort_kurz,
  info.vorverkaufKommt && `Vorverkauf ab ${fmt.tagMonat(site.vorverkauf_ab)}`,
  d?.regie && `Regie ${d.regie}`,
].filter(Boolean) as string[];

const jsonLd = d && kommend.length
  ? {
      '@context': 'https://schema.org',
      '@graph': kommend.map((t) => ({
        '@type': 'TheaterEvent',
        name: d.titel,
        startDate: isoMitZone(t.datum, t.uhrzeit),
        eventStatus: 'https://schema.org/EventScheduled',
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        description: d.kurztext || undefined,
        location: {
          '@type': 'Place',
          name: site.spielort_name,
          address: { '@type': 'PostalAddress', streetAddress: site.spielort_strasse, addressLocality: site.spielort_ort.replace(/^\d+\s*/, ''), postalCode: site.spielort_ort.match(/^\d+/)?.[0], addressCountry: 'DE' },
        },
        organizer: { '@type': 'PerformingGroup', name: site.seitentitel, url: Astro.site?.toString() },
        offers: t.extern
          ? { '@type': 'Offer', url: t.href, availability: t.status === 'ausverkauft' ? 'https://schema.org/SoldOut' : t.status === 'wenige' ? 'https://schema.org/LimitedAvailability' : 'https://schema.org/InStock' }
          : undefined,
      })),
    }
  : null;
---
<Base jsonLd={jsonLd}>
  <!-- 1 + 2: Bühne mit Stück, Ticket-Button und Eckdaten -->
  <StueckBuehne info={info} variante="start" />

  {laufband.length > 0 && (
    <div class="laufband-huelle" aria-hidden="true">
      <div class="laufband">
        <div class="laufband__spur">
          {[0, 1].map(() => (
            <div class="laufband__gruppe">
              {laufband.map((eintrag) => <><span>{eintrag}</span><i></i></>)}
              {laufband.map((eintrag) => <><span>{eintrag}</span><i></i></>)}
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- 3: Termine mit Kauf-Button je Vorstellung -->
  <Termine info={info} />

  <!-- 4: Mehr aus unserem Verein, als Programmheft in drei Akten -->
  <section class="wrap abschnitt programm" aria-labelledby="programm-titel">
    <div class="kopfzeile">
      <div class="stapel">
        <p class="label">Das Programmheft</p>
        <h2 id="programm-titel" class="display h-l">Mehr aus <span class="serif">unserem</span> Verein</h2>
      </div>
      <p class="programm__intro body-2">Wer auf der Bühne steht, wer nachkommt und was schon gespielt wurde: ein Abend in drei Akten.</p>
    </div>
    <div class="akte">
      <Akt
        nummer="I"
        akt="Erster Akt"
        titel="Das Ensemble"
        text="Wer auf der Bühne steht und wer dahinter arbeitet: Besetzung, Regie und Technik zum aktuellen Stück."
        href={pfad('/aktuelles-stueck/#besetzung')}
        linkText="Besetzung ansehen"
        bild={d?.ensemble_bild}
      >
        {ensemble.length > 0 ? (
          <ul class="akt__liste">{ensemble.map((p) => <li><span>{p.rolle}</span><b>{p.name}</b></li>)}</ul>
        ) : (
          <Luecke block text="Ensemble-Foto und Besetzung im Stück eintragen" />
        )}
      </Akt>
      <Akt
        nummer="II"
        akt="Zweiter Akt"
        titel="Junges Theater der SGN"
        text={jt.intro}
        href={pfad('/junges-theater/')}
        linkText="Zum Jungen Theater"
        bild={jt.aktuell_bild}
      >
        {jt.altersgruppe || jt.probenzeit
          ? <p class="akt__fakt">{[jt.altersgruppe, jt.probenzeit].filter(Boolean).join(' · ')}</p>
          : <Luecke block text="Altersgruppe und Probenzeiten ergänzen" />}
        {jtStuecke.length > 0 && <ul class="akt__liste">{jtStuecke.map((e) => <li><span>{e.jahr}</span><b>{e.titel}</b></li>)}</ul>}
      </Akt>
      <Akt
        nummer="III"
        akt="Dritter Akt"
        titel="Frühere Aufführungen"
        text={`Ein Blick ins Archiv: ${chronik.length} Produktionen seit ${Math.min(...chronik.map((e) => e.jahr))}, mit Stücken, Spielzeiten und Fotos.`}
        href={pfad('/chronik/')}
        linkText="Archiv ansehen"
        bild={archivBild}
      >
        <ul class="akt__liste">{archiv.map((e) => <li><span>{e.jahr}</span><b>{e.titel}</b></li>)}</ul>
      </Akt>
    </div>
  </section>

  <!-- 5: Hinter den Kulissen und Fotos -->
  <section class="stage grain kulissen" aria-labelledby="kulissen-titel">
    <div class="licht licht--arbeit" aria-hidden="true"></div>
    <div class="wrap abschnitt kulissen__inner">
      <div class="kulissen__kopf">
        <p class="label">Hinter den Kulissen</p>
        <h2 id="kulissen-titel" class="display h-l">{kulissenKopf.trim()}</h2>
        {kulissenNachsatz && <p class="kulissen__text">…&nbsp;{kulissenNachsatz}</p>}
      </div>
      <div class:list={['kulissen__raster', { 'kulissen__raster--ohne-video': !btsDa && !(platzhalter && d?.behind_the_scenes) }]}>
        {btsDa ? (
          <div class="kulissen__video">
            <Video src={d!.behind_the_scenes} format="hoch" titel="Behind the Scenes" kicker="Video" />
          </div>
        ) : platzhalter && d?.behind_the_scenes ? (
          <div class="kulissen__video"><Luecke block text={`Video-Datei fehlt: ${d.behind_the_scenes.split('/').pop()} unter Medien › Dateien hochladen`} /></div>
        ) : null}
        <div class="kulissen__fotos">
          {probenfotos.length > 0 ? (
            <ul class="kontaktbogen">
              {probenfotos.map((b, i) => <li><span class="foto__bild"><Bild src={b} alt={`Probenfoto ${i + 1}`} sizes="(max-width: 700px) 50vw, 25vw" /></span></li>)}
            </ul>
          ) : platzhalter ? (
            <ul class="kontaktbogen">{[1, 2, 3, 4].map((n) => <li><Luecke block text={`Probenfoto ${n}`} /></li>)}</ul>
          ) : null}
          {albumfotos.length > 0 && (
            <div class="stapel" style="gap:14px">
              <p class="kicker">Aus dem Fotoalbum</p>
              <ul class="kontaktbogen kontaktbogen--klein">
                {albumfotos.map((f) => (
                  <li><figure class="foto"><span class="foto__bild"><Bild src={f.bild} alt={`Foto aus ${f.titel}`} sizes="(max-width: 700px) 33vw, 16vw" /></span><figcaption>{f.titel} · {f.jahr}</figcaption></figure></li>
                ))}
              </ul>
            </div>
          )}
          <p class="kulissen__fuss">
            <a class="pfeil-link" href={pfad('/fotos/')}>Zum Fotoalbum<Icon name="pfeil" size={16} /></a>
            {(fotografen.length > 0 || platzhalter) && <span>Fotos: {fotografen.length ? fotografen.join(', ') : <Luecke text="Name der Fotografen" />}</span>}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6: Mitmachen und Mitglied werden -->
  <Mitmachen />
</Base>
