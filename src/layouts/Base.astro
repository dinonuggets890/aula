---
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Ticketleiste from '../components/Ticketleiste.astro';
import { site, pfad, noindex } from '../lib/data';
import type { Bereich } from '../lib/navigation';

interface Props {
  titel?: string;
  beschreibung?: string;
  aktiv?: Bereich | '';
  footerKompakt?: boolean;
  /** Ticket-Button am unteren Rand (Smartphone); auf der Kartenseite aus */
  ticketleiste?: boolean;
  jsonLd?: object | null;
}
const { titel, beschreibung = site.beschreibung, aktiv = '', footerKompakt = false, ticketleiste = true, jsonLd = null } = Astro.props;
const voll = titel ? `${titel} · ${site.seitentitel}` : site.seitentitel;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogBild = new URL(pfad('/og.jpg'), Astro.site);
const buehne = site.buehnenflaechen === 'hell' ? 'hell' : 'dunkel';
---
<!doctype html>
<html lang="de" data-buehne={buehne}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Vor dem ersten Zeichnen: Bewegung ja/nein, Sparmodus für schwache Geräte.
      // „ruhig“: Nutzer wünscht wenig Bewegung. „sparsam“: wenige Kerne, wenig Speicher oder Datensparmodus.
      (function () {
        var d = document.documentElement, n = navigator, c = n.connection || {};
        var ruhig = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        var sparsam = (n.hardwareConcurrency || 4) <= 2 || (n.deviceMemory || 4) <= 2 || c.saveData === true;
        d.classList.add(ruhig || !('IntersectionObserver' in window) ? 'ruhig' : 'bewegt');
        if (sparsam) d.classList.add('sparsam');
      })();
    </script>
    <title>{voll}</title>
    <meta name="description" content={beschreibung} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={pfad('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={pfad('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#b01f2d" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.seitentitel} />
    <meta property="og:title" content={voll} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogBild} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <Header aktiv={aktiv} />
    <main id="inhalt">
      <slot />
    </main>
    <Footer kompakt={footerKompakt} />
    {ticketleiste && <Ticketleiste />}
    <script>
      import '../scripts/bewegung';
      import '../scripts/lightbox';
    </script>
  </body>
</html>
