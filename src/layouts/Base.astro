---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/data';

interface Props {
  titel?: string;
  beschreibung?: string;
  aktiv?: 'chronik' | 'karten' | 'fotos' | '';
  footerKompakt?: boolean;
  jsonLd?: object | null;
}
const { titel, beschreibung = site.beschreibung, aktiv = '', footerKompakt = false, jsonLd = null } = Astro.props;
const voll = titel ? `${titel} · ${site.seitentitel}` : site.seitentitel;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogBild = new URL('/og.jpg', Astro.site);
const buehne = site.buehnenflaechen === 'hell' ? 'hell' : 'dunkel';
---
<!doctype html>
<html lang="de" data-buehne={buehne}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{voll}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#b11e2e" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.seitentitel} />
    <meta property="og:title" content={voll} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogBild} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <Header aktiv={aktiv} />
    <main id="inhalt">
      <slot />
    </main>
    <Footer kompakt={footerKompakt} />
  </body>
</html>
