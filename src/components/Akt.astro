---
/**
 * Ein „Akt“ im Programmheft der Startseite (Erster, Zweiter, Dritter Akt).
 * Römische Ziffer im gekippten roten Rahmen, Bild in Rot getönt.
 * (WordPress: Block-Pattern „akt“)
 */
import Bild from './Bild.astro';
import Icon from './Icon.astro';

interface Props {
  nummer: 'I' | 'II' | 'III';
  akt: string;
  titel: string;
  text: string;
  href: string;
  linkText: string;
  bild?: string;
}
const { nummer, akt, titel, text, href, linkText, bild = '' } = Astro.props;
const id = `akt-${nummer.toLowerCase()}`;
---
<article class="akt" aria-labelledby={id}>
  <div class="akt__bild">
    {bild ? <Bild src={bild} alt="" sizes="(max-width: 700px) 100vw, 33vw" /> : <span class="akt__leer" aria-hidden="true"></span>}
    <span class="akt__ziffer" aria-hidden="true"><span>{nummer}</span></span>
  </div>
  <div class="akt__text">
    <p class="kicker rot">{akt}</p>
    <h3 id={id}>{titel}</h3>
    <p>{text}</p>
    <slot />
    <a class="pfeil-link" href={href}>{linkText}<Icon name="pfeil" size={16} /></a>
  </div>
</article>
