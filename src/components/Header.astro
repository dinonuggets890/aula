---
import Icon from './Icon.astro';
import { site, mailto, pfad } from '../lib/data';
import { navigation, type Bereich } from '../lib/navigation';

interface Props {
  aktiv?: Bereich | '';
}
const { aktiv = '' } = Astro.props;
---
<header class="kopf">
  <div class="wrap kopf__inner">
    <a class="kopf__logo" href={pfad('/')} aria-label={`${site.seitentitel}, zur Startseite`}>
      <img src={pfad('/img/logo-rot.svg')} alt="Die Aula, Schauspielgruppe Neusäß e.V." width="859" height="296" />
    </a>
    <nav class="kopf__nav" aria-label="Hauptnavigation">
      {navigation.map((l) => (
        <a href={pfad(l.href)} aria-current={aktiv === l.key ? 'page' : undefined}>{l.text}</a>
      ))}
      <a class="btn btn--rot btn--klein" href={pfad('/karten/')} aria-current={aktiv === 'karten' ? 'page' : undefined}>
        <Icon name="ticket" size={18} />Tickets
      </a>
    </nav>
    <div class="kopf__mobil">
      <a class="btn btn--rot btn--klein kopf__tickets" href={pfad('/karten/')}>Tickets</a>
      <button class="menu-btn" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobilmenu" data-menu-auf>
        <Icon name="menu" size={26} />
      </button>
    </div>
  </div>
  <div class="mobilmenu" id="mobilmenu" role="dialog" aria-modal="true" aria-label="Menü" hidden>
    <div class="mobilmenu__kopf">
      <img src={pfad('/img/logo-weiss.svg')} alt="Die Aula, Schauspielgruppe Neusäß e.V." width="859" height="296" />
      <button class="menu-btn" type="button" aria-label="Menü schließen" data-menu-zu>
        <Icon name="schliessen" size={26} />
      </button>
    </div>
    <nav aria-label="Hauptnavigation mobil">
      <ul class="mobilmenu__liste">
        {navigation.map((l, i) => (
          <li style={`--i:${i}`}>
            <a class="mobilmenu__haupt" href={pfad(l.href)} aria-current={aktiv === l.key ? 'page' : undefined} data-menu-link>{l.text}</a>
            {l.unter.length > 0 && (
              <p class="mobilmenu__unter">
                {l.unter.map((u) => <a href={pfad(u.href)} data-menu-link>{u.text}</a>)}
              </p>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="mobilmenu__fuss">
      <a class="btn btn--papier" href={pfad('/karten/')}>Tickets<Icon name="pfeil" /></a>
      <a href={mailto}>{site.email}</a>
    </div>
  </div>
</header>

<script>
  const menu = document.getElementById('mobilmenu');
  const auf = document.querySelector<HTMLButtonElement>('[data-menu-auf]');
  const zu = document.querySelector<HTMLButtonElement>('[data-menu-zu]');
  function setze(offen: boolean) {
    if (!menu || !auf) return;
    menu.hidden = !offen;
    auf.setAttribute('aria-expanded', String(offen));
    document.body.style.overflow = offen ? 'hidden' : '';
    (offen ? zu : auf)?.focus();
  }
  auf?.addEventListener('click', () => setze(true));
  zu?.addEventListener('click', () => setze(false));
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setze(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) setze(false);
  });
</script>
