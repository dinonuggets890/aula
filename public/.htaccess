# Apache-Einstellungen für den Strato-Webspace

# Immer per HTTPS ausliefern
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Alte WordPress-Adressen auf die neuen Seiten umleiten
  RewriteRule ^aktuelles-stueck/?$ /#stueck [R=301,L,NE]
  RewriteRule ^eintrittskarten/?$ /karten/ [R=301,L]
  RewriteRule ^auffuehrungen(/.*)?$ /chronik/ [R=301,L]
  RewriteRule ^fotoalbum(/.*)?$ /fotos/ [R=301,L]
  RewriteRule ^verein/mitgliedschaft/?$ /#mitmachen [R=301,L,NE]
  RewriteRule ^verein/junges-theater-in-der-sgn(/.*)?$ /#mitmachen [R=301,L,NE]
  RewriteRule ^verein(/wir-ueber-uns)?/?$ /#verein [R=301,L,NE]
  RewriteRule ^(feed|comments/feed|category/.*|author/.*|20[0-9][0-9]/.*|wir-freuen-uns-.*)/?$ / [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(js|css|woff2|avif|webp|jpg|jpeg|png|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json application/xml
</IfModule>
